# Создаётся Ansible. Один экземпляр приложения на веб-ноде.
# TLS здесь не терминируется: сертификаты живут только на балансировщике.
name: t2-app

services:
  app:
    build:
      context: /opt/t2-mobile
    image: {{ app_image }}
    environment:
      APP_ENV: production
      INSTANCE_ID: "{{ inventory_hostname }}"
      SECRET_KEY: "{{ secret_key }}"
      DATABASE_URL: "postgresql+asyncpg://{{ postgres_user }}:{{ postgres_password }}@{{ hostvars[groups['storage'][0]]['ansible_host'] }}:5432/{{ postgres_db }}"
      REDIS_URL: "redis://{{ hostvars[groups['storage'][0]]['ansible_host'] }}:6379/0"
      SESSION_COOKIE_SECURE: "{{ 'true' if enable_tls else 'false' }}"
    ports:
      # Слушаем только внутренний адрес ноды, а не все интерфейсы:
      # иначе приложение доступно по обычному HTTP в обход балансировщика,
      # и вся TLS-терминация теряет смысл.
      - "{{ hostvars[inventory_hostname]['ansible_host'] }}:{{ app_port }}:8000"
    restart: unless-stopped
