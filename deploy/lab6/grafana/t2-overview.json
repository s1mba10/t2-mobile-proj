      ]
    },
    {
      "type": "stat",
      "title": "Запросов в секунду",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "t2-prometheus"
      },
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "t2-prometheus"
          },
          "expr": "sum(rate(t2_http_requests_total[1m]))",
          "legendFormat": "rps",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "type": "piechart",
      "title": "Доля запросов по нодам",
      "description": "Главная иллюстрация балансировки: доли должны быть примерно равны при round-robin.",
      "datasource": {
        "type": "prometheus",
        "uid": "t2-prometheus"
      },
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 9,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "displayLabels": [
          "percent"
        ],
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "t2-prometheus"
          },
          "expr": "sum by (instance_id) (rate(t2_http_requests_total[5m]))",
          "legendFormat": "{{instance_id}}",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Запросы по нодам",
