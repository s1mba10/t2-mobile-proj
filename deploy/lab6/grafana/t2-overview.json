{
  "uid": "t2-overview",
  "title": "t2 — портал и кластер",
  "description": "Практическая работа №6: метрики узлов Swarm и распределение запросов между нодами портала t2.",
  "tags": [
    "t2",
    "swarm",
    "practical-work-6"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "type": "stat",
      "title": "Живых экземпляров портала",
      "description": "Сколько реплик приложения отдают метрики. Меньше двух — балансировать нечего.",
      "datasource": {
        "type": "prometheus",
        "uid": "t2-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "t2-prometheus"
          },
          "expr": "count(up{job=\"t2_app\"} == 1)",
          "legendFormat": "экземпляры",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Нод в кластере",
      "description": "",
