# Application
APP_NAME=t2-mobile
APP_ENV=development
SECRET_KEY=change-me-in-production
INSTANCE_ID=local-dev
LOG_LEVEL=INFO

# Bind HTTP only. TLS is terminated on Apache/Nginx in later labs.
APP_HOST=0.0.0.0
APP_PORT=8000

# Shared stores (must not live on a single app node)
DATABASE_URL=postgresql+asyncpg://t2:t2@localhost:5432/t2mobile
REDIS_URL=redis://localhost:6379/0

# Session cookie (not stored in process memory or local files)
SESSION_COOKIE_NAME=t2_session
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=false
